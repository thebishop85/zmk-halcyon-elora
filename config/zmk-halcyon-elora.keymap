#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

#define DEFAULT  0
#define NAV      1
#define SYM      2
#define FUNCTION 3
#define ADJUST   4

/ {
    combos {
        compatible = "zmk,combos";

        palette {
            bindings = <&kp F17>;
            key-positions = <28 27>;
            layers = <0>;
        };
    };

    macros {
        new_macro1: new_macro1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp T &kp E &kp S &kp T &kp E &kp N1 &kp N2 &kp N3 &kp N4 &kp N5>;
            label = "NEW_MACRO1";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        qwerty_layer {
            display-name = "Default";

            // ---------------------------------------------------------------------------------------------------------------
            // |  ESC  |  1   |  2  |  3  |  4  |   5   |                               |  6  |  7  |  8  |  9  |  0  | BSPC |
            // |  TAB  |  Q   |  W  |  E  |  R  |   T   |                               |  Y  |  U  |  I  |  O  |  P  | BSPC |
            // |LC(ESC)|  A   |  S  |  D  |  F  |   G   |                               |  H  |  J  |  K  |  L  |  ;  |  '   |
            // |  SHFT |  Z   |  X  |  C  |  V  |   B   | LBKT | CAPS |   | FUNC | RBKT |  N  |  M  |  ,  |  .  |  /  | SHFT |
            //                      | ADJ | GUI |LA(ENT)| SPC  | NAV  |   | SYM  | SPC  | ALT | GUI | APP |

            bindings = <
&kp ESC        &kp N1  &kp N2  &kp N3     &kp N4        &kp N5                                                                 &kp N6  &kp N7    &kp N8     &kp N9   &kp N0    &kp ESC
&kp TAB        &kp Q   &kp W   &kp E      &kp R         &kp T                                                                  &kp Y   &kp U     &kp I      &kp O    &kp P     &kp BSPC
&kp BACKSPACE  &kp A   &kp S   &kp D      &kp F         &kp G                                                                  &kp H   &kp J     &kp K      &kp L    &kp SEMI  &mt RCTRL SQT
&mo 4          &kp Z   &kp X   &kp C      &kp V         &kp B    &kp F17               &kp ESC             &mo 2  &kp RBKT     &kp N   &kp M     &kp COMMA  &kp DOT  &kp FSLH  &kp RSHFT
                               &kp LCTRL  &kp LEFT_ALT  &kp DEL  &mt LEFT_SHIFT SPACE  &mt LEFT_GUI ENTER  &mo 2  &lt 1 ENTER  &mo 1   &kp RGUI  &kp K_APP
&kp RGUI       &none   &none   &none      &none                                                                                        &none     &none      &none    &none     &kp RGUI
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOL_UP C_VOL_DN>,
                <&inc_dec_kp PG_UP PG_DN>,
                <&inc_dec_kp C_VOL_UP C_VOL_DN>,
                <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        // Uncomment one of the following layers, and comment the Qwerty layer, if you want to use Colemak or Dvorak layouts
        // dvorak_layer {
        //     display-name = "Default Layer";
        //     bindings = <
        //     &kp ESC       &kp N1   &kp N2    &kp N3     &kp N4   &kp N5                                                 &kp N6   &kp N7  &kp N8 &kp N9 &kp N0 &kp ESC
        //     &kp TAB       &kp SQT  &kp COMMA &kp DOT    &kp P    &kp Y                                                  &kp F    &kp G    &kp C &kp R &kp L &kp BSPC
        //     &mt LCTRL ESC &kp A    &kp O     &kp E      &kp U    &kp I                                                  &kp D    &kp H    &kp T &kp N &kp S &mt RCTRL SQT
        //     &kp LSHFT     &kp SEMI &kp Q     &kp J      &kp K    &kp X        &kp LBKT  &kp CAPS &mo FUNCTION &kp RBKT  &kp B    &kp M    &kp W &kp V &kp Z &kp RSHFT
        //                                      &mo ADJUST &kp LGUI &mt LALT RET &kp SPACE &mo NAV  &mo SYM      &kp SPACE &kp RALT &kp RGUI &kp K_APP
        //
        //     &kp RGUI &none &none &none &none                                                                                          &none &none &none &none &kp RGUI
        //     >;
        //
        //     sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN &inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        // };
        // colemak_dh_layer {
        //     display-name = "Default Layer";
        //     bindings = <
        //     &kp ESC       &kp N1 &kp N2 &kp N3   &kp N4   &kp N5                                                 &kp N6   &kp N7   &kp N8    &kp N9  &kp N0   &kp ESC
        //     &kp TAB       &kp Q &kp W &kp F      &kp P    &kp B                                                  &kp J    &kp L    &kp U     &kp Y   &kp SEMI &kp BSPC
        //     &mt LCTRL ESC &kp A &kp R &kp S      &kp T    &kp G                                                  &kp M    &kp N    &kp E     &kp I   &kp O    &mt RCTRL SQT
        //     &kp LSHFT     &kp Z &kp X &kp C      &kp D    &kp V        &kp LBKT  &kp CAPS &mo FUNCTION &kp RBKT  &kp K    &kp H    &kp COMMA &kp DOT &kp FSLH &kp RSHFT
        //                               &mo ADJUST &kp LGUI &mt LALT RET &kp SPACE &mo NAV  &mo SYM      &kp SPACE &kp RALT &kp RGUI &kp K_APP
        //
        //     &kp RGUI &none &none &none &none                                                                                          &none &none &none &none &kp RGUI
        //     >;
        //
        //     sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN &inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        // };

        navigation_layer {
            display-name = "Navigation";

            // ------------------------------------------------------------------------------------------------------------
            // |     |     |     |     |     |STDIO|                            |       |      |     |     |       |      |
            // |     |     |     |     |     |     |                            | PG_UP | HOME | UP  | END | VOL_UP| DEL  |
            // |     | GUI | ALT | CTL | SHFT|     |                            | PG_DN | LEFT | DOWN| RGT | VOL_DN| INS  |
            // |     |     |     |     |     |     |     | SLCK |   |     |     | PAUSE | PREV | PLAY| NEXT| MUTE  | PSCRN|
            //                   |     |     |     |     |      |   |     |     |       |      |     |

            bindings = <
&studio_unlock  &kp F1          &kp F2     &kp F3     &kp F4     &kp F5                                          &kp F6       &kp F7      &kp F8            &kp F9      &kp F10       &kp F11
&trans          &trans          &trans     &trans     &trans     &trans                                          &kp PG_UP    &kp HOME    &kp UP            &kp END     &kp K_VOL_UP  &kp F12
&trans          &kp LEFT_BRACE  &kp LALT   &kp LCTRL  &kp LSHFT  &trans                                          &kp PG_DN    &kp LEFT    &kp DOWN          &kp RIGHT   &kp K_MUTE    &kp INS
&trans          &kp LG(Z)       &kp LG(X)  &kp LG(C)  &kp LG(V)  &trans  &kp LS(LG(N4))  &trans  &trans  &trans  &kp C_PAUSE  &kp K_PREV  &kp K_PLAY_PAUSE  &kp K_NEXT  &kp K_VOL_DN  &kp PSCRN
                                           &trans     &trans     &trans  &trans          &trans  &trans  &trans  &trans       &trans      &trans
&trans          &trans          &trans     &trans     &trans                                                                  &trans      &trans            &trans      &trans        &trans
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOL_UP C_VOL_DN>,
                <&inc_dec_kp PG_UP PG_DN>,
                <&inc_dec_kp C_VOL_UP C_VOL_DN>,
                <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        numpad_layer {
            display-name = "Function";

            // -----------------------------------------------------------------------------------------------------
            // |     |     |     |     |     |     |                           |     |     |     |     |     |     |
            // |     | F9  | F10 | F11 | F12 |     |                           |     |     |     |     |     |     |
            // |     | F5  | F6  | F7  | F8  |     |                           |     |RSHFT|RCTRL| LALT| RGUI|     |
            // |     | F1  | F2  | F3  | F4  |     |     |     |   |     |     |     |     |     |     |     |     |
            //                   |     |     |     |     |     |   |     |     |     |     |     |

            bindings = <
&trans  &trans  &trans    &trans        &trans     &studio_unlock                                  &trans  &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp KP_DIVIDE    &trans
&trans  &trans  &trans    &kp UP_ARROW  &trans     &trans                                          &trans  &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp KP_PLUS      &trans
&trans  &trans  &kp LEFT  &kp DOWN      &kp RIGHT  &trans                                          &trans  &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp KP_ASTERISK  &trans
&trans  &trans  &trans    &trans        &trans     &trans          &trans  &trans  &trans  &trans  &trans  &kp KP_NUMBER_0  &kp KP_DOT       &trans           &kp KP_MINUS     &trans
                          &trans        &trans     &trans          &trans  &trans  &to 0   &trans  &trans  &kp EQUAL        &trans
&trans  &trans  &trans    &trans        &trans                                                             &trans           &trans           &trans           &trans           &trans
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOL_UP C_VOL_DN>,
                <&inc_dec_kp PG_UP PG_DN>,
                <&inc_dec_kp C_VOL_UP C_VOL_DN>,
                <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        adjust_layer {
            display-name = "Adjust";

            // -----------------------------------------------------------------------------------------------------------------------
            // |     |     |     |     |     |     |                           |       |       |       |       |       |     |
            // | BOOT|     |BTCLR| BT1 | BT2 | BT3 |                           |       |       |       |       |       |BOOT |
            // |     |     |     | BT4 | BT5 |     |                           | RGB_ON|RGB_HUI|RGB_SAI|RGB_BRI|RGB_EFF|     |
            // |     |     |     |     |     |     |     |     |   |     |     |RGB_OFF|RGB_HUD|RGB_SAD|RGB_BRD|RGB_EFR|     |
            //                   |     |     |     |     |     |   |     |     |       |       |       |

            bindings = <
&trans       &trans  &trans      &trans        &trans        &trans                                        &trans           &trans           &trans           &trans           &trans           &trans
&bootloader  &trans  &bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2                                  &trans           &trans           &trans           &trans           &trans           &bootloader
&trans       &trans  &trans      &bt BT_SEL 3  &bt BT_SEL 4  &trans                                        &rgb_ug RGB_ON   &rgb_ug RGB_SAI  &rgb_ug RGB_HUI  &rgb_ug RGB_BRI  &rgb_ug RGB_EFF  &trans
&trans       &trans  &trans      &trans        &trans        &trans        &trans  &trans  &trans  &trans  &rgb_ug RGB_OFF  &rgb_ug RGB_SAD  &rgb_ug RGB_HUD  &rgb_ug RGB_BRD  &rgb_ug RGB_EFR  &trans
                                 &trans        &trans        &trans        &trans  &trans  &trans  &trans  &trans           &trans           &trans
&trans       &trans  &trans      &trans        &trans                                                                       &trans           &trans           &trans           &trans           &trans
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOL_UP C_VOL_DN>,
                <&inc_dec_kp PG_UP PG_DN>,
                <&inc_dec_kp C_VOL_UP C_VOL_DN>,
                <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        media_layer {
            bindings = <
&trans  &trans  &trans          &trans             &trans      &trans                                  &studio_unlock  &trans       &trans  &trans  &trans  &trans
&trans  &trans  &trans          &kp C_VOLUME_UP    &trans      &trans                                  &trans          &trans       &trans  &trans  &trans  &trans
&trans  &trans  &trans          &kp C_VOLUME_DOWN  &trans      &trans                                  &trans          &new_macro1  &trans  &trans  &trans  &trans
&trans  &trans  &kp C_PREVIOUS  &kp C_PLAY_PAUSE   &kp C_NEXT  &trans  &trans  &trans  &trans  &trans  &trans          &trans       &trans  &trans  &trans  &trans
                                &trans             &trans      &trans  &trans  &trans  &trans  &trans  &trans          &trans       &trans
&trans  &trans  &trans          &trans             &trans                                                              &trans       &trans  &trans  &trans  &trans
            >;
        };
    };
};
